# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template MUST ship: it is the only record of which variables a
# teammate needs to set, and `.env*` above silently swallows it.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# NOTE: the two outputs of scripts/sync-design.mjs are deliberately NOT ignored.
# They are generated, but they are also build inputs: globals.css imports the
# stylesheet, and the page fetches /tb/bundle.js at runtime. Ignoring them made
# the build depend on the `prebuild` npm lifecycle hook, and `next build` run
# directly — which is what a plain CI job does — failed on a fresh clone.
# They are regenerated on every dev and build, so drift shows up as a diff.

# Local editor/agent settings
.claude/
