# Nothing in this file is needed to run the demo. With no .env.local at all the
# app runs on bundled sample data: no sign-in, no database, no API keys, and
# each browser keeps its own answers in cookies. Copy this to .env.local only to
# run the full version against Supabase and a Databricks warehouse.

# Supabase — project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Who reads an uploaded resume: "databricks" (default) runs ai_query in the
# warehouse and needs only the DATABRICKS_* variables below; "anthropic" sends
# the PDF to Claude and needs the key below.
RESUME_PROVIDER=databricks

# Anthropic — console.anthropic.com. Only needed for RESUME_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Resume tailor (/resume): anthropic | databricks | rules. Unset picks Databricks, then
# Anthropic, by which credentials are present, and falls back to rules (no model).
TAILOR_PROVIDER=

# Shared secret the cron poller must present. Generate: openssl rand -hex 32
CRON_SECRET=

# Networking module selection. Defaults to the built-in placeholder.
NETWORKING_PROVIDER=placeholder

# People provider for the connection engine. "mock" reads the bundled cast and
# is what the demo runs on; "databricks" reads a SQL warehouse.
PEOPLE_PROVIDER=mock
# Workspace URL, e.g. https://dbc-xxxxxxxx-xxxx.cloud.databricks.com (no trailing slash, no ?o=).
DATABRICKS_HOST=
# SQL warehouse id (SQL Warehouses -> your warehouse -> Connection details). DATABRICKS_HTTP_PATH
# is accepted too; its last path segment is the id.
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_HTTP_PATH=
# Personal access token: avatar -> Settings -> Developer -> Access tokens. Never commit it.
DATABRICKS_TOKEN=
# Optional. The ai_query model. Free Edition hosts no Claude endpoints; Llama
# 3.3 70B follows instructions best of the set it does host.
DATABRICKS_MODEL=databricks-meta-llama-3-3-70b-instruct

# Demo mode only. DEMO_PREFILL=1 seeds the in-memory student with a fully answered
# questionnaire so the dashboard ranks on every tier without walking the questions live.
# Leave unset for the questionnaire-first flow.
DEMO_PREFILL=

# Openings provider. Falls back to PEOPLE_PROVIDER, so one variable flips the whole app.
POSITIONS_PROVIDER=

# Demo mode keeps each browser's student in workspace.jobsearch.demo_sessions when DATABRICKS_* is set,
# so it survives Vercel's separate function instances. Set DEMO_SESSIONS=memory to force the in-process map.
DEMO_SESSIONS=
